API_PORT=3001
# Required to read /api/audit and /api/chat/log (send it as the x-admin-token header)
ADMIN_TOKEN=change-me
# Gemini API key from Google AI Studio. Without it the chat answers with safe templates only.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_MS=15000
# The pilot export is as of this date; in production leave it to today's date
AS_OF_DATE=2026-10-25
POLICY_SOURCE=csv
